{
  "name": "codeshare-recording-bot",
  "version": "1.0.0",
  "description": "Recording bot server for CodeShare Meet - uses headless browser to record meetings",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:xvfb": "xvfb-run --auto-servernum --server-args='-screen 0 1920x1080x24 -ac' node server.js",
    "dev": "node server.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "puppeteer": "^24.0.0",
    "uuid": "^9.0.0"
  }
}
