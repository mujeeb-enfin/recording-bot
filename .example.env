# Recording Bot Server Configuration

# Server Port
RECORDING_BOT_PORT=4000

# API Secret (must match main server's RECORDING_BOT_SECRET)
RECORDING_BOT_SECRET=recording-bot-secret-key-change-in-production

# Recording Storage
RECORDINGS_DIR=./recordings
MAX_CONCURRENT_RECORDINGS=5

# Main Server URL (where meetings are hosted)
MAIN_SERVER_URL=https://localhost:3200

RECORDING_FPS=20 #30
RECORDING_VIDEO_BITRATE=1000000 #8Mbps
RECORDING_AUDIO_BITRATE=64000 #192kbps
RECORDING_CHUNK_INTERVAL=100
RECORDING_CODEC=vp8
RECORDING_BOT_HEADLESS=false #false to open rowser